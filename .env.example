# Скопируй в .env:  cp .env.example .env
# .env лежит в .gitignore и на GitHub не уедет. Репозиторий публичный:
# утёкший ключ отзывается за минуты. В код и промпты ключ не вставлять.

# Один ключ на текст и картинки — из чата капитанов (openrouter.ai/models)
OPENROUTER_API_KEY=

# Альтернатива — прямой DeepSeek (platform.deepseek.com); тогда в config.yaml:
# llm.base_url: https://api.deepseek.com/chat/completions
# llm.api_key_env: DEEPSEEK_API_KEY, llm.model: deepseek-chat
DEEPSEEK_API_KEY=

# Только если делаете телеграм-бота: токен от @BotFather
TELEGRAM_BOT_TOKEN=
