# Скопируй этот файл в .env и вставь ключи из чата капитанов:
#   cp .env.example .env
#
# .env лежит в .gitignore и в репозиторий не попадёт.
# Репозиторий публичный: утёкший ключ отзывают за минуты, и вау-слой умирает
# посреди билда. Не вставляйте ключи в код, промпты и сообщения коммитов.

# Текст и диалоги — сотни моделей по одному ключу (openrouter.ai/models)
OPENROUTER_API_KEY=

# Картинки и видео за секунды (fal.ai)
FAL_KEY=

# Голос и озвучка (elevenlabs.io)
ELEVENLABS_API_KEY=

# Картинки, видео, музыка (replicate.com)
REPLICATE_API_TOKEN=

# Запасной мозг с щедрым бесплатным лимитом (aistudio.google.com)
GOOGLE_API_KEY=

# Только если выбрали телеграм-бота: токен от @BotFather
TELEGRAM_BOT_TOKEN=
